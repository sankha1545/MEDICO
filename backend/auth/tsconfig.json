{
  "compilerOptions": {
    // ✨ ECMAScript and module resolution
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    // ✨ Directory structure
    "rootDir": "src",
    "outDir": "dist",

    // ⚠️ Allow JS output even if there are TypeScript errors
    "noEmitOnError": false,

    // ⚡ Loosened type-checking to avoid blocking development builds
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,

    // 🔄 Enable ES module compatibility and JSON imports
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // ✅ Enforce consistent file casing in imports
    "forceConsistentCasingInFileNames": true,

    // 📦 Allow using custom and external types
    "typeRoots": [
      "./node_modules/@types",
      "./src/types",
      "./types"
    ],

    // 🧠 Explicitly include types for packages
    "types": [
      "node",
      "express",
      "express-session",
      "cors",
      "mongoose",
      "razorpay",
      "jsonwebtoken",
      "passport",
      "passport-google-oauth20"
    ]
  },

  "include": [
    "src/**/*",
    "src/types/**/*",
    "types/**/*"
  ]
}

import React, { useState } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { useNavigate } from 'react-router-dom';
import { X, User, UserPlus, CheckCircle } from 'lucide-react';

const steps = ['chooseRole', 'benefits', 'final'] as const;
type Step = typeof steps[number];

const backdrop = {
  visible: { opacity: 1 },
  hidden: { opacity: 0 },
};

const modal = {
  hidden: { opacity: 0, scale: 0.75, y: 50 },
  visible: {
    opacity: 1,
    scale: 1,
    y: 0,
    transition: { type: 'spring', stiffness: 300, damping: 25 },
  },
  exit: {
    opacity: 0,
    scale: 0.75,
    y: -50,
    transition: { duration: 0.3 },
  },
};

export default function StartJourneyModal({ onClose }: { onClose(): void }) {
  const navigate = useNavigate();
  const [step, setStep] = useState<Step>('chooseRole');
  const [role, setRole] = useState<'doctor' | 'patient' | null>(null);

  const next = () => {
    const idx = steps.indexOf(step);
    if (idx < steps.length - 1) setStep(steps[idx + 1]);
  };

  const finish = () => {
    if (role) navigate(`/signup?role=${role}`);
    onClose();
  };

  return (
    <AnimatePresence>
      <motion.div
        className="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-60"
        variants={backdrop}
        initial="hidden"
        animate="visible"
        exit="hidden"
      >
        <motion.div
          className="relative w-11/12 max-w-md p-6 overflow-hidden bg-white shadow-2xl rounded-2xl"
          variants={modal}
          initial="hidden"
          animate="visible"
          exit="exit"
        >
          {/* Close Button */}
          <button className="absolute text-gray-400 top-4 right-4 hover:text-gray-600" onClick={onClose}>
            <X size={24} />
          </button>

          {/* Progress Bar */}
          <div className="flex items-center mb-6">
            {steps.map((s, i) => (
              <div key={s} className="flex-1">
                <motion.div
                  className={`h-1 bg-gray-300 rounded-full`}
                  animate={{ backgroundColor: steps.indexOf(step) >= i ? '#6366f1' : '#d1d5db' }}
                  transition={{ duration: 0.3 }}
                />
              </div>
            ))}
          </div>

          {/* Step Content */}
          {step === 'chooseRole' && (
            <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}>
              <h2 className="mb-4 text-2xl font-semibold text-center text-gray-800">
                Who Are You?
              </h2>
              <div className="flex justify-center space-x-4">
                <button
                  onClick={() => { setRole('patient'); next(); }}
                  className="flex flex-col items-center justify-center flex-1 py-3 text-white transition transform bg-indigo-600 shadow-lg hover:bg-indigo-700 rounded-xl hover:scale-105"
                >
                  <User size={32} className="mb-2" />
                  <span>Patient</span>
                </button>
                <button
                  onClick={() => { setRole('doctor'); next(); }}
                  className="flex flex-col items-center justify-center flex-1 py-3 text-white transition transform bg-green-600 shadow-lg hover:bg-green-700 rounded-xl hover:scale-105"
                >
                  <UserPlus size={32} className="mb-2" />
                  <span>Doctor</span>
                </button>
              </div>
            </motion.div>
          )}

          {step === 'benefits' && (
            <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}>
              <h2 className="mb-4 text-2xl font-semibold text-center text-gray-800">
                Why MedicoX?
              </h2>
              <ul className="space-y-3">
                {role === 'patient' ? (
                  ['Find top doctors instantly', 'Secure online booking', 'Automated reminders'].map((txt) => (
                    <li key={txt} className="flex items-center text-gray-700">
                      <CheckCircle className="mr-2 text-indigo-500" /> {txt}
                    </li>
                  ))
                ) : (
                  ['Grow your practice', 'Manage appointments', 'Easy payouts'].map((txt) => (
                    <li key={txt} className="flex items-center text-gray-700">
                      <CheckCircle className="mr-2 text-green-500" /> {txt}
                    </li>
                  ))
                )}
              </ul>
              <button
                onClick={next}
                className="w-full py-3 mt-6 text-white transition transform bg-indigo-600 shadow-lg hover:bg-indigo-700 rounded-xl hover:scale-105"
              >
                Continue
              </button>
            </motion.div>
          )}

          {step === 'final' && (
            <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}>
              <h2 className="mb-4 text-2xl font-semibold text-center text-gray-800">
                Let’s Get Started!
              </h2>
              <p className="mb-6 text-center text-gray-600">
                You’re all set. Create your account and begin your journey with MedicoX.
              </p>
              <button
                onClick={finish}
                className="w-full py-3 text-white transition transform shadow-2xl bg-gradient-to-r from-indigo-500 to-purple-500 hover:from-indigo-600 hover:to-purple-600 rounded-xl hover:scale-105"
              >
                Start Now
              </button>
            </motion.div>
          )}
        </motion.div>
      </motion.div>
    </AnimatePresence>
  );
}
